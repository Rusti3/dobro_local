{
  "title": "VolunteerOpportunitySemanticAnnotation",
  "description": "Only semantic fields that are not already deterministic in the DOBRO source data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "quality",
    "supplementalClassification",
    "participation",
    "inferredRequirements",
    "complexity",
    "firstTimeFit",
    "feedSignals",
    "evidence",
    "confidence",
    "shortExplanation"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "enum": ["semantic-1.1.0"] },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "taskClarity", "reasons", "explanation"],
      "properties": {
        "status": { "type": "string", "enum": ["suitable", "clarification_required", "hidden", "human_review"] },
        "taskClarity": { "type": "string", "enum": ["clear", "partial", "missing", "contradictory"] },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "clear_task", "sufficient_conditions", "missing_task", "vague_duties", "missing_time",
              "missing_location", "missing_duration", "missing_requirements", "missing_join_process",
              "promotional_without_task", "meaningless_text", "suspected_spam", "contradictory_conditions",
              "potential_safety_risk", "vulnerable_people_without_safeguards",
              "specialized_work_without_requirements", "other"
            ]
          }
        },
        "explanation": { "type": "string" }
      }
    },
    "supplementalClassification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supplementalCauseAreas", "beneficiaryGroups", "additionalVolunteerTasks"],
      "properties": {
        "supplementalCauseAreas": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "elderly_support", "disability_inclusion", "donor_movement", "humanitarian_aid",
              "poverty_crisis_support", "homelessness_support", "refugee_displaced_support", "nonprofit_support"
            ]
          }
        },
        "beneficiaryGroups": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "animals", "elderly_people", "children", "youth", "people_with_disabilities",
              "people_with_health_conditions", "families_in_crisis", "low_income_people", "homeless_people",
              "refugees_displaced_people", "blood_marrow_recipients", "military_personnel", "veterans",
              "emergency_survivors", "local_community", "cultural_audiences", "sports_participants",
              "nonprofit_organizations", "environment", "general_public", "other", "unclear"
            ]
          }
        },
        "additionalVolunteerTasks": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "animal_care", "dog_walking", "companionship", "visiting", "escort_navigation",
              "event_setup_teardown", "event_guest_support", "registration_check_in", "crowd_navigation",
              "sports_marshalling", "teaching", "mentoring", "workshop_facilitation",
              "professional_consulting", "translation_language_support", "administration_data_entry",
              "fundraising_outreach", "donation_collection", "sorting_packing", "delivery_transport",
              "cooking_food_prep", "cleaning_improvement", "repair_construction", "sewing_knitting_crafts",
              "technical_making", "photography_video", "design_content_smm", "medical_donation",
              "search_rescue_emergency", "coordination", "volunteer_coordination", "volunteer_training",
              "event_logistics_resources", "medical_care_support", "patient_escort", "document_admin",
              "phone_outreach", "partnerships", "survey_research", "museum_archive_support",
              "public_safety_monitoring", "food_service", "environmental_monitoring", "heritage_preservation",
              "rehabilitation_support", "it_technical_support", "performance_entertainment", "other", "unclear"
            ]
          }
        }
      }
    },
    "participation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modes", "commitment", "scheduleSpecificity"],
      "properties": {
        "modes": { "type": "array", "items": { "type": "string", "enum": ["solo", "pair", "small_group", "large_group", "unknown"] } },
        "commitment": { "type": "string", "enum": ["one_off", "multiple_visits", "regular", "flexible", "unknown"] },
        "scheduleSpecificity": { "type": "string", "enum": ["exact_shift", "date_window", "by_agreement", "recurring_schedule", "unknown"] }
      }
    },
    "inferredRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownResources", "additionalPrerequisites", "unknownConditions"],
      "properties": {
        "ownResources": {
          "type": "array",
          "items": { "type": "string", "enum": ["own_pet", "smartphone", "camera", "computer", "car", "tools", "protective_equipment", "materials", "money_for_materials"] }
        },
        "additionalPrerequisites": {
          "type": "array",
          "items": { "type": "string", "enum": ["language_skill", "driving_license", "professional_qualification", "health_eligibility", "application", "interview", "training", "parental_consent", "source_registration"] }
        },
        "unknownConditions": {
          "type": "array",
          "items": { "type": "string", "enum": ["exact_duties", "exact_location", "exact_time", "duration", "physical_requirements", "training", "supervision", "equipment", "accessibility", "group_participation", "remote_process"] }
        }
      }
    },
    "complexity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["physicalLoad", "emotionalLoad", "skillRequirement", "socialLoad", "responsibility", "entryBarrier", "timeCommitment", "overall", "explanation"],
      "properties": {
        "physicalLoad": { "type": "string", "enum": ["minimal", "light", "moderate", "heavy", "unknown"] },
        "emotionalLoad": { "type": "string", "enum": ["low", "moderate", "high", "unknown"] },
        "skillRequirement": { "type": "string", "enum": ["none", "briefing", "specialized", "licensed", "unknown"] },
        "socialLoad": { "type": "string", "enum": ["solitary", "low", "moderate", "high", "unknown"] },
        "responsibility": { "type": "string", "enum": ["supervised_simple", "independent_routine", "high", "safety_critical", "unknown"] },
        "entryBarrier": { "type": "string", "enum": ["walk_in", "registration", "application", "training", "selection", "unknown"] },
        "timeCommitment": { "type": "string", "enum": ["up_to_2h", "half_day", "full_day", "multi_day", "regular", "unknown"] },
        "overall": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "explanation": { "type": "string" }
      }
    },
    "firstTimeFit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "score", "positives", "concerns", "explanation"],
      "properties": {
        "verdict": { "type": "string", "enum": ["suitable", "conditional", "not_suitable", "unknown"] },
        "score": { "type": ["integer", "null"] },
        "positives": {
          "type": "array",
          "items": { "type": "string", "enum": ["clear_duties", "simple_tasks", "no_experience_required", "briefing_provided", "coordinator_support", "flexible_schedule", "short_shift", "choice_of_tasks", "group_format", "remote_format"] }
        },
        "concerns": {
          "type": "array",
          "items": { "type": "string", "enum": ["unclear_duties", "unclear_conditions", "specialized_skill", "qualification_required", "high_physical_load", "high_emotional_load", "high_social_load", "high_responsibility", "long_or_regular_commitment", "application_or_selection", "own_resource_required", "age_or_consent_condition", "safety_needs_review"] }
        },
        "explanation": { "type": "string" }
      }
    },
    "feedSignals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["friendsAllowed", "remoteTask", "calmTask", "firstTimeCandidate"],
      "properties": {
        "friendsAllowed": { "type": "string", "enum": ["yes", "no", "unknown"] },
        "remoteTask": { "type": "string", "enum": ["yes", "no", "unknown"] },
        "calmTask": { "type": "string", "enum": ["yes", "no", "unknown"] },
        "firstTimeCandidate": { "type": "string", "enum": ["yes", "conditional", "no", "unknown"] }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "value", "basis", "quote", "interpretation"],
        "properties": {
          "target": {
            "type": "string",
            "enum": ["quality_status", "cause_area", "beneficiary_group", "volunteer_task", "participation", "commitment", "resource", "requirement", "physical_load", "emotional_load", "skill_requirement", "social_load", "responsibility", "entry_barrier", "time_commitment", "first_time_fit", "friends_allowed", "remote_task", "calm_task"]
          },
          "value": { "type": ["string", "null"] },
          "basis": { "type": "string", "enum": ["source_quote", "structured_source", "inference", "assumption"] },
          "quote": { "type": "string" },
          "interpretation": { "type": "string" }
        }
      }
    },
    "confidence": { "type": "number" },
    "shortExplanation": { "type": "string" }
  }
}
