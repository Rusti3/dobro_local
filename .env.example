# Локальная демонстрация без токена MAX (cookie-сессия)
DEMO_MODE=true
PORT=3210
HOST=127.0.0.1

# PostgreSQL. Docker Compose создаёт отдельного несуперпользователя приложения.
POSTGRES_ADMIN_PASSWORD=replace-admin-password
POSTGRES_APP_PASSWORD=replace-app-password
POSTGRES_PORT=54329
DATABASE_URL=postgresql://dobrie_dela_app:replace-app-password@127.0.0.1:54329/dobrie_dela
DB_SCHEMA=app
DB_POOL_SIZE=10

# MAX Bot API. Токен хранится только на сервере.
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
MAX_MINI_APP_URL=https://example.ru

# Production Webhook (HTTPS, сертификат доверенного УЦ, включая Минцифры)
MAX_WEBHOOK_URL=https://example.ru/api/max/webhook
MAX_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Для локальной разработки с токеном: true; при активной подписке webhook — false
MAX_POLLING=true
# MAX_CA_BUNDLE=./russiantrustedca.pem

# Почасовой каталог ДОБРО и очередь LLM-разметки.
CATALOG_CITIES=Москва
CATALOG_SYNC_ENABLED=true
CATALOG_SYNC_ON_START=true
CATALOG_SYNC_INTERVAL_MS=3600000
DOBRO_CONCURRENCY=4

LLM_BASE_URL=http://host.docker.internal:8080/v1
# Отдельное значение для контейнера, если API работает на хостовой машине.
DOCKER_LLM_BASE_URL=http://host.docker.internal:8080/v1
LLM_API_KEY=replace-with-llm-key
LLM_MODEL=gpt-5.6-terra
ANNOTATION_CONCURRENCY=5
ANNOTATION_BATCH_SIZE=100
ANNOTATION_POLL_INTERVAL_MS=15000
